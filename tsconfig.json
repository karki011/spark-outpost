{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": [
    "scripts",
    "tests",
    "infra/heartbeat-worker/src",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "scripts/bench/fixture",
    "scripts/e2e-live/dev-day/fixtures",
    "scripts/e2e-live/story/fixture",
    "scripts/e2e-live/story/hidden",
    "scripts/e2e-live/story/reference"
  ]
}
