{
  "name": "spark-outpost",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @spark-outpost/server --filter @spark-outpost/web dev",
    "desktop:dev": "pnpm --filter @spark-outpost/web build && pnpm --filter @spark-outpost/desktop dev",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:source && pnpm model-cards:check && pnpm knip && pnpm a11y:contrast --quiet && pnpm acp:coverage && pnpm test",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:source": "tsx scripts/check-source.ts",
    "model-cards:check": "tsx scripts/model-cards-check.ts",
    "knip": "knip --no-progress",
    "a11y:contrast": "tsx scripts/contrast-audit.ts",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:live": "vitest run --project live",
    "test:browser": "playwright test",
    "db:setup": "bash infra/local/setup.sh",
    "db:up": "bash infra/local/up.sh",
    "db:stop": "bash infra/local/stop.sh",
    "db:migrate": "pnpm --filter @spark-outpost/server db:migrate",
    "acp:coverage": "tsx scripts/acp-coverage.ts",
    "bench:ingest": "node --env-file-if-exists=.local/credentials.env --import tsx scripts/bench-ingest.ts",
    "jev:thresholds": "node --env-file-if-exists=.local/credentials.env --import tsx scripts/jev-thresholds.ts",
    "bench:harness": "node --env-file-if-exists=.local/credentials.env --import tsx scripts/bench-harness.ts",
    "e2e:live": "node --env-file-if-exists=.local/credentials.env --import tsx scripts/e2e-live/run.ts",
    "e2e:story": "node --env-file-if-exists=.local/credentials.env --import tsx scripts/e2e-live/story/cli.ts",
    "routing:labels": "node --env-file-if-exists=.local/credentials.env --import tsx scripts/routing/labels.ts",
    "routing:replay": "node --import tsx scripts/routing/replay.ts",
    "routing:escalation": "node --import tsx scripts/routing/escalation-dry.ts",
    "routing:ratings": "node --env-file-if-exists=.local/credentials.env --import tsx scripts/routing/ratings-live.ts",
    "coord:shadow": "node --env-file-if-exists=.local/credentials.env --import tsx scripts/coordinator/shadow.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "knip": "^5.88.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
