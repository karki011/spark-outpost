{
  "name": "spark-outpost",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @spark-outpost/server --filter @spark-outpost/web dev",
    "desktop:dev": "pnpm --filter @spark-outpost/web build && pnpm --filter @spark-outpost/desktop dev",
    "desktop:package": "pnpm --filter @spark-outpost/web build && pnpm --filter @spark-outpost/desktop build && pnpm --filter @spark-outpost/desktop package",
    "desktop:tmux": "pnpm --filter @spark-outpost/desktop tmux",
    "desktop:mac-control": "pnpm --filter @spark-outpost/desktop mac-control",
    "desktop:calendar": "pnpm --filter @spark-outpost/desktop calendar",
    "desktop:voice": "pnpm --filter @spark-outpost/desktop voice",
    "desktop:no-activate": "pnpm --filter @spark-outpost/desktop no-activate",
    "desktop:dev-app": "pnpm --filter @spark-outpost/desktop dev-app",
    "desktop:release": "pnpm --filter @spark-outpost/desktop release",
    "desktop:e2e-update": "pnpm --filter @spark-outpost/web build && pnpm --filter @spark-outpost/desktop build && pnpm --filter @spark-outpost/desktop e2e:update",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:source && pnpm check:docs && pnpm release:downloads --check && pnpm model-cards:check && pnpm knip && pnpm a11y:contrast --quiet && pnpm acp:coverage && pnpm test",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:source": "tsx scripts/check-source.ts",
    "check:docs": "tsx scripts/check-guide.ts",
    "release:downloads": "tsx scripts/release-downloads.ts",
    "model-cards:check": "tsx scripts/model-cards-check.ts",
    "knip": "knip --no-progress",
    "a11y:contrast": "tsx scripts/contrast-audit.ts",
    "test": "vitest run --project unit",
    "test:changed": "vitest run --project unit --changed main",
    "test:db": "vitest run --project db",
    "test:db:changed": "tsx scripts/test-changed.ts db",
    "test:live": "vitest run --project live",
    "test:browser": "playwright test",
    "test:browser:changed": "tsx scripts/test-changed.ts browser",
    "test:browser:perf": "SPARK_WEB_BUILD=1 playwright test perf.spec.ts",
    "test:browser:shards": "tsx scripts/browser-shards.ts",
    "test:browser:packaged": "SPARK_PACKAGED=1 playwright test --grep @packaged",
    "docs:screenshots": "SPARK_DOCS_SHOTS=1 playwright test tests/browser/docs-shots --workers=1",
    "db:setup": "bash infra/local/setup.sh",
    "db:up": "bash infra/local/up.sh",
    "db:stop": "bash infra/local/stop.sh",
    "db:migrate": "pnpm --filter @spark-outpost/server db:migrate",
    "acp:coverage": "tsx scripts/acp-coverage.ts",
    "bench:ingest": "node --env-file-if-exists=.local/credentials.env --import tsx scripts/bench-ingest.ts",
    "bench:loop": "node --env-file-if-exists=.local/credentials.env --import tsx scripts/codescan/loop-bench.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "knip": "^5.88.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
