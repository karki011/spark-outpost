{
  "name": "@spark-outpost/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "esbuild src/main.ts src/server-entry.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist --external:electron --external:embedded-postgres --external:pg --external:tsx",
    "dev": "pnpm build && electron .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@spark-outpost/contracts": "workspace:*",
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "electron": "44.4.5",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15"
  }
}
